<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Nur fuer die (abschaltbare) taegliche Erinnerung an Jahrestage; wird erst beim Einschalten erfragt. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- allowBackup=false: Der Sitzungs-Cookie und spaeter der Lese-Cache enthalten
         Daten lebender Personen und duerfen nicht in ein Cloud-Backup wandern. -->
    <application
        android:name=".WtApp"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.WtAnd">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Verbinden" aus webtrees (Seite "App" des Moduls): webtreesand://connect?url=...&tree=...&code=...&user=... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="webtreesand" android:host="connect" />
            </intent-filter>
        </activity>
        <!-- Kamera-Aufnahmen landen in einer eigenen Datei im Cache; die Kamera-App bekommt nur fuer diese Datei Schreibrecht. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
